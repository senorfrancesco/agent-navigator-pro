# Offline bundle runtime contract for release/v1.0

BUNDLE_VERSION=v1.0
RELEASE_BRANCH=release/v1.0

# Image tags expected by compose.offline.yaml
BACKEND_APP_IMAGE=agent-nav-backend-app-offline:v1.0
UMS_IMAGE=agent-nav-ums-offline:v1.0
CHAINLIT_IMAGE=agent-nav-chainlit-offline:v1.0
VLLM_IMAGE=agent-nav-vllm-offline:v1.0

# Published ports
AGENT_API_PORT=8000
DOCUMENT_SERVER_PORT=8001
LEGAL_SERVER_PORT=8002
UMS_PORT=8090
CHAINLIT_PORT=3000
VLLM_PORT=8101
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# Service network contract inside docker runtime
AGENT_API_HOST=0.0.0.0
UMS_HOST=0.0.0.0
UMS_URL=http://ums:8090
DOC_SERVER_URL=http://document-server:8001
LEGAL_SERVER_URL=http://legal-server:8002

# Offline state contract and operator secrets
CHAINLIT_AUTH_SECRET=change-me-before-deploy
CHAINLIT_ADMIN_USER=admin
CHAINLIT_ADMIN_PASSWORD=change-me-before-deploy
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-before-deploy

# Model registry and model weights inside the offline bundle container layout.
# These paths are what the containers should see after bind mounts from ./models.
MODEL_REGISTRY_CONFIG_PATH=/app/backend/config/models.yaml
MODEL_PATH_LLM=/app/backend/models/gguf/qwen-14b/Qwen2.5-14B-Instruct-Q4_K_M.gguf
# VLM пока не входит в обязательный runtime contract release/v1.0.
# Оставить закомментированным, пока multimodal path не реализован в прод-режиме.
# MODEL_PATH_VLM=/app/backend/models/gguf/Qwen3-VL-8B-Q4/Qwen3-VL-8B-Instruct-Q4_K_M.gguf
# MMPROJ_PATH=/app/backend/models/gguf/Qwen3-VL-8B-Q4/mmproj-Qwen3-VL-8B-Instruct-F16.gguf
MODEL_PATH_EMBEDDING_INTENT=/app/backend/models/st/Qwen3-Embedding-0.6B
MODEL_PATH_EMBEDDING_RETRIEVAL=/app/backend/models/st/LaBSE
# Optional legacy/auxiliary embedders.
# MODEL_PATH_E5_LEGAL=/app/backend/models/st/E5-legal
# MODEL_PATH_RUBERT=/app/backend/models/st/Rubert

# State DBs restored by restore_state.sh
ORCHESTRATOR_STATE_DB_URL=sqlite:////app/backend/.data/orchestrator_state.db
ORCHESTRATOR_KB_DB_URL=sqlite:////app/backend/.data/orchestrator_kb.db
CHAINLIT_DB_URL=sqlite+aiosqlite:////app/backend/.data/chainlit.db

# Режим runtime и политика llama/vLLM
# Для `release/v1.0` heavy GGUF path обслуживается через `llama-server`
# внутри `UMS` image, собранного из локального checkout
# `deploy/offline_bundle/vendor/llama.cpp/` в профиле Release.
# Для текущего сервера с NVIDIA A4000 канонический CUDA arch для сборки UMS image: 86.
BACKEND_MODE=llama-server
UMS_RUNTIME_PROFILE=adaptive
DEVICE_MODE=hybrid
LLM_DEVICE_MODE=hybrid
VLM_DEVICE_MODE=hybrid
INTENT_EMBEDDER_DEVICE_MODE=cpu
RETRIEVAL_EMBEDDER_DEVICE_MODE=cpu
# Если нужно ограничить heavy path конкретными GPU, указать индексы через запятую.
# Для одной карты можно оставить пустым; для нескольких A4000 пример: 0,1
UMS_LLM_GPU_INDICES=
# GPU_LAYERS_MODE управляет стратегией выбора offload:
# - auto: оставить выбор коду runtime/tier selector;
# - max: пытаться держать максимум слоёв на GPU;
# - manual: использовать явные значения *_QWEN*/override из env.
GPU_LAYERS_MODE=auto
# N_GPU_LAYERS_OVERRIDE влияет на tier selection целиком.
# Это грубый глобальный override для heavy LLM path, который читает TierSelector
# до запуска модели. Удобен для forcing/debug, но он не является per-model настройкой.
# Если нужен целевой runtime-параметр именно для qwen-14b-llm из model registry,
# используйте N_GPU_LAYERS_QWEN14B ниже.
N_GPU_LAYERS_OVERRIDE=
UMS_LLAMA_CACHE_PROMPT=true
VLLM_BASE_URL=http://vllm:8000
VLLM_API_KEY=
VLLM_MODEL_ID_QWEN_14B_LLM=qwen-14b-llm
VLLM_MODEL_SOURCE_QWEN_14B_LLM=Qwen/Qwen2.5-14B-Instruct
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=16384
ACTIVE_MODEL_ID=none

# Model context and generation defaults
# CONTEXT_SIZE_QWEN14B и N_GPU_LAYERS_QWEN14B - per-model runtime knobs из model registry.
# Именно эти переменные использует get_model_config() для qwen-14b-llm перед сборкой
# фактической команды llama-server.
# Если N_GPU_LAYERS_QWEN14B не задан, registry fallback остаётся на default (-1).
# Если одновременно задать N_GPU_LAYERS_OVERRIDE и N_GPU_LAYERS_QWEN14B,
# возможен конфликт восприятия в логах:
# - tier/startup logs покажут global override;
# - финальная команда llama-server будет собрана по per-model config после refresh.
CONTEXT_SIZE_QWEN14B=16384
N_GPU_LAYERS_QWEN14B=
CONTEXT_SIZE_QWENVL=16384
CONTEXT_SIZE_LABSE=512
CONTEXT_SIZE_QWEN3_EMBEDDING_06B=512
TEMPERATURE=0.5
TOP_P=0.9
REPETITION_PENALTY=1.2
MAX_TOKENS=2048

# Chainlit data layer and profile defaults
CHAINLIT_ENABLE_DATA_LAYER=true
CHAINLIT_SQLITE_TIMEOUT_S=30
CHAINLIT_DEFAULT_TEMPERATURE=0.7
CHAINLIT_DEFAULT_TOP_P=0.9
CHAINLIT_DEFAULT_MAX_TOKENS=2048
CHAINLIT_MODEL_PROFILE_DEFAULT_CHAT_MODEL=qwen-14b-llm
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_MODEL=qwen-14b-llm
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_MODEL=qwen-14b-llm
CHAINLIT_MODEL_PROFILE_LOW_VRAM_MODEL=qwen-14b-llm
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_TEMPERATURE=0.3
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_TOP_P=0.9
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_MAX_TOKENS=3072
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_TEMPERATURE=0.2
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_TOP_P=0.8
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_MAX_TOKENS=2048
CHAINLIT_MODEL_PROFILE_LOW_VRAM_TEMPERATURE=0.2
CHAINLIT_MODEL_PROFILE_LOW_VRAM_TOP_P=0.8
CHAINLIT_MODEL_PROFILE_LOW_VRAM_MAX_TOKENS=1024
CHAINLIT_INTENT_EMBEDDER_PROFILE_DEFAULT_MODEL=qwen3-embedding-0.6b
CHAINLIT_RETRIEVAL_EMBEDDER_PROFILE_LEGAL_DEFAULT_MODEL=labse-embedding
CHAINLIT_RETRIEVAL_EMBEDDER_PROFILE_LOW_VRAM_MODEL=labse-embedding
CHAINLIT_REPORT_PDF_DISPLAY=inline

# Intent classification and retrieval policy
INTENT_CLASSIFIER_MODE=embedder
INTENT_CLASSIFIER_EMBEDDER_MODEL=qwen3-embedding-0.6b
INTENT_CLASSIFIER_LLM_MODEL=qwen-14b-llm
INTENT_CLASSIFIER_LLM_CONFIDENCE_THRESHOLD=0.75
INTENT_CLASSIFIER_EMBEDDER_CONFIDENCE_THRESHOLD=0.60
INTENT_CLASSIFIER_EMBEDDER_MARGIN_THRESHOLD=0.10
LEGAL_EMBEDDER_MODEL=labse-embedding
RAG_MODE_OVERRIDE=auto

# Конкурентность UMS и генерация отчётов
UMS_LLM_MAX_CONCURRENCY=1
UMS_EMBED_MAX_CONCURRENCY=4
UMS_CONCURRENCY_ACQUIRE_TIMEOUT_S=5.0
UMS_FAIL_FAST_ON_SATURATION=false
REPORT_PDF_FONT_PATH=

# Bundle-relative mounts expected by compose
UPLOADS_DIR=/app/backend/uploads
HOST_UPLOADS_DIR=/app/backend/uploads

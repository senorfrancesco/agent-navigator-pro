# ===========================================
# Agent Navigator Pro - Конфигурация
# ===========================================
# Скопируйте этот файл в .env и настройте под вашу систему:
#   cp .env.example .env

# -------------------------------------------
# Пути к GGUF Моделям (LLM)
# -------------------------------------------
MODEL_PATH_QWEN14B="./models/gguf/qwen-14b/Qwen2.5-14B-Instruct-Q4_K_M.gguf"
MODEL_PATH_QWENVL="./models/gguf/Qwen3-VL-8B-Q4/Qwen3-VL-8B-Instruct-Q4_K_M.gguf"
MMPROJ_PATH="./models/gguf/Qwen3-VL-8B-Q4/mmproj-Qwen3-VL-8B-Instruct-F16.gguf"

# -------------------------------------------
# Пути к Sentence Transformer Моделям (Эмбеддинги)
# -------------------------------------------
MODEL_PATH_LABSE="./models/st/LaBSE"
MODEL_PATH_E5_LEGAL="./models/st/E5-legal"
MODEL_PATH_RUBERT="./models/st/Rubert"

# -------------------------------------------
# Настройки GPU слоёв (-1 = все слои на GPU)
# -------------------------------------------
N_GPU_LAYERS_QWEN14B=-1
N_GPU_LAYERS_QWENVL=-1
N_GPU_LAYERS_LABSE=10

# -------------------------------------------
# Размеры контекстного окна
# -------------------------------------------
CONTEXT_SIZE_QWEN14B=16384
CONTEXT_SIZE_QWENVL=16384
CONTEXT_SIZE_LABSE=512

# -------------------------------------------
# Параметры генерации (для снижения галлюцинаций)
# -------------------------------------------
TEMPERATURE=0.5
TOP_P=0.9
REPETITION_PENALTY=1.2
MAX_TOKENS=2048

# -------------------------------------------
# Настройки API сервисов
# -------------------------------------------
AGENT_API_HOST="0.0.0.0"
AGENT_API_PORT=8000

UMS_HOST="0.0.0.0"
UMS_PORT=8090
UMS_URL="http://localhost:8090"

DOC_SERVER_URL="http://localhost:8001"
LEGAL_SERVER_URL="http://localhost:8002"

# -------------------------------------------
# Режим бэкенда
# -------------------------------------------
# Варианты: llama-cpp-python, llama-server, vllm
BACKEND_MODE="llama-cpp-python"

# -------------------------------------------
# Активная модель по умолчанию
# -------------------------------------------
ACTIVE_MODEL_ID="none"

# -------------------------------------------
# Chainlit UI (auth + persistence)
# -------------------------------------------
CHAINLIT_AUTH_SECRET="agent-navigator-secret-key-change-me"
CHAINLIT_ADMIN_USER="admin"
CHAINLIT_ADMIN_PASSWORD="admin"
CHAINLIT_DB_URL="sqlite+aiosqlite:///.data/chainlit.db"

# -------------------------------------------
# RAG Pipeline
# -------------------------------------------
# auto = определяется из UMS tier config
# simple / corrective / agentic = жёсткий override
RAG_MODE_OVERRIDE="auto"

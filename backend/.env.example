# ===========================================
# Agent Navigator Pro - пример конфигурации
# ===========================================
# Скопируйте этот файл в backend/.env и настройте под вашу систему:
#   cp backend/.env.example backend/.env
# Динамически добавленные через Open WebUI модели не нужно прописывать здесь:
# они хранятся в backend/.data/ums_dynamic_models.json.

# -------------------------------------------
# Канонические пути к моделям
# -------------------------------------------
MODEL_PATH_LLM="./models/gguf/qwen-14b/Qwen2.5-14B-Instruct-Q4_K_M.gguf"
# Назначение: основной статический GGUF-файл текстовой LLM для UMS.
MODEL_PATH_VLM="./models/gguf/Qwen3-VL-8B-Q4/Qwen3-VL-8B-Instruct-Q4_K_M.gguf"
# Назначение: основной статический GGUF-файл vision-модели для UMS.
MMPROJ_PATH="./models/gguf/Qwen3-VL-8B-Q4/mmproj-Qwen3-VL-8B-Instruct-F16.gguf"
# Назначение: mmproj-файл для vision GGUF-модели llama.cpp.

# -------------------------------------------
# Пути к embedding-моделям
# -------------------------------------------
MODEL_PATH_EMBEDDING_INTENT="./models/st/Qwen3-Embedding-0.6B"
# Назначение: локальная модель эмбеддингов для классификации намерений.
MODEL_PATH_EMBEDDING_RETRIEVAL="./models/st/LaBSE"
# Назначение: локальная модель эмбеддингов для поиска по знаниям и документам.
MODEL_PATH_E5_LEGAL="./models/st/E5-legal"
# Назначение: дополнительная юридическая embedding-модель из static registry.
MODEL_PATH_RUBERT="./models/st/Rubert"
# Назначение: дополнительная RuBERT-модель для классификации или поиска.

# -------------------------------------------
# Inventory-backed дополнительные локальные модели
# -------------------------------------------
MODEL_PATH_QWEN32B="./models/gguf/qwen2.5-32b-q4/qwen2.5-32b-instruct-q4-merged.gguf"
# Назначение: дополнительная Qwen 32B GGUF-модель для large-VRAM профиля.
MODEL_PATH_LLAMA31_8B="./models/gguf/llama-3.1-8b/Meta-Llama-3.1-8B-Instruct-Q5_K_M.gguf"
# Назначение: дополнительная Llama 3.1 8B GGUF-модель.
MODEL_PATH_MISTRAL_7B="./models/gguf/mistral-7b-q6/mistral-7b-instruct-v0.2.Q6_K.gguf"
# Назначение: дополнительная Mistral 7B GGUF-модель.
MODEL_PATH_PHI3_MINI_Q4="./models/gguf/phi-3-mini-q4/Phi-3-mini-4k-instruct-q4.gguf"
# Назначение: низко-VRAM fallback-модель Phi 3 Mini.
MODEL_PATH_SAIGA_YANDEXGPT_8B="./models/gguf/saiga-yandexgpt-8b/saiga_yandexgpt_8b.Q8_0.gguf"
# Назначение: дополнительная Saiga/YandexGPT GGUF-модель.
MODEL_PATH_YANDEXGPT_LITE_8B="./models/gguf/yandexgpt-lite-8b/YandexGPT-5-Lite-8B-instruct-Q4_K_M.gguf"
# Назначение: дополнительная YandexGPT Lite GGUF-модель.
MODEL_PATH_BGE_M3="./models/st/bge-m3"
# Назначение: дополнительная BGE-M3 embedding-модель.
MODEL_PATH_MULTILINGUAL_E5="./models/st/multilingual-e5-large-instruct"
# Назначение: дополнительная multilingual-e5 embedding-модель.
MODEL_PATH_XLMR_XNLI="./models/st/xlm-roberta-large-xnli"
# Назначение: дополнительная XLM-R XNLI модель для классификации.

# -------------------------------------------
# Native runtime / placement
# -------------------------------------------
UMS_RUNTIME_PROFILE="adaptive"
# Назначение: профиль расчёта runtime-бюджетов; adaptive подстраивается под железо.
DEVICE_MODE="hybrid"
# Назначение: общий режим размещения моделей, если нет component-specific override.
LLM_DEVICE_MODE="gpu"
# Назначение: режим размещения текстовой LLM.
VLM_DEVICE_MODE="gpu"
# Назначение: режим размещения vision-модели.
INTENT_EMBEDDER_DEVICE_MODE="cpu"
# Назначение: режим размещения embedding-модели классификации намерений.
RETRIEVAL_EMBEDDER_DEVICE_MODE="cpu"
# Назначение: режим размещения retrieval embedding-модели.
GPU_LAYERS_MODE="max"
# Назначение: стратегия выбора GPU-слоёв для legacy preflight и runtime-оценки.
N_GPU_LAYERS_OVERRIDE="-1"
# Назначение: общий override GPU-слоёв, если конкретная модель не задаёт свой параметр.
UMS_LLM_GPU_INDICES=
# Назначение: список GPU для размещения тяжёлой LLM; пусто означает auto.
UMS_EMBEDDING_GPU_INDEX=
# Назначение: GPU для embedding runtime; пусто означает auto или CPU по device mode.
UMS_LLM_MIN_FREE_VRAM_GB=0
# Назначение: минимальная свободная VRAM для допуска GPU в LLM-размещение.
UMS_LLM_MIN_BALANCE_RATIO=0.5
# Назначение: минимальное отношение свободной VRAM карты к самой свободной карте в пуле.
UMS_ALLOW_HEAVY_CPU_DEGRADE_AFTER_GPU_FAILURE=false
# Назначение: разрешает CPU fallback после GPU-ошибки тяжёлой модели.
UMS_MANUAL_EFFECTIVE_CONTEXT_TOKENS=
# Назначение: ручной effective-context budget; пусто означает расчёт из профиля.
UMS_RETRIEVED_CONTEXT_RATIO=0.6
# Назначение: доля effective context, резервируемая под извлечённые документы.
UMS_GENERATION_TOKENS_RESERVE=1024
# Назначение: резерв токенов под ответ модели.

# -------------------------------------------
# Настройки GPU-слоёв моделей
# -------------------------------------------
N_GPU_LAYERS_QWEN14B=-1
# Назначение: число слоёв Qwen 14B на GPU; -1 означает все доступные слои.
N_GPU_LAYERS_QWENVL=-1
# Назначение: число слоёв Qwen VL на GPU; -1 означает все доступные слои.
N_GPU_LAYERS_LABSE=10
# Назначение: legacy-параметр offload для LaBSE, если используется GPU-режим.
N_GPU_LAYERS_QWEN3_EMBEDDING_06B=0
# Назначение: offload для Qwen3 embedding; 0 оставляет модель на CPU.

# -------------------------------------------
# Размеры контекстного окна
# -------------------------------------------
CONTEXT_SIZE_QWEN14B=16384
# Назначение: размер контекста для Qwen 14B.
CONTEXT_SIZE_QWENVL=16384
# Назначение: размер контекста для Qwen VL.
CONTEXT_SIZE_LABSE=512
# Назначение: базовый размер входа для LaBSE.
CONTEXT_SIZE_QWEN3_EMBEDDING_06B=512
# Назначение: базовый размер входа для Qwen3 embedding.

# -------------------------------------------
# Параметры генерации
# -------------------------------------------
TEMPERATURE=0.5
# Назначение: температура генерации для дефолтных запросов.
TOP_P=0.9
# Назначение: nucleus sampling, ограничивает вероятностную массу токенов.
REPETITION_PENALTY=1.2
# Назначение: штраф за повторения в локальной генерации.
MAX_TOKENS=2048
# Назначение: дефолтный лимит новых токенов ответа.

# -------------------------------------------
# Настройки API-сервисов
# -------------------------------------------
AGENT_API_HOST="0.0.0.0"
# Назначение: интерфейс, на котором слушает основной Agent API.
AGENT_API_PORT=8000
# Назначение: host-порт основного Agent API.
DOC_PORT=8001
# Назначение: host-порт document MCP server.
LEGAL_PORT=8002
# Назначение: host-порт legal MCP server.

UMS_HOST="0.0.0.0"
# Назначение: интерфейс, на котором слушает Unified Model Server.
UMS_PORT=8090
# Назначение: host-порт Unified Model Server.
UMS_URL="http://localhost:8090"
# Назначение: URL UMS для backend-сервисов при native-запуске.

EMBEDDING_RUNTIME_HOST="0.0.0.0"
# Назначение: интерфейс, на котором слушает отдельный embedding runtime.
EMBEDDING_RUNTIME_PORT=8092
# Назначение: host-порт отдельного embedding runtime для Open WebUI RAG.
EMBEDDING_MODEL_ID="labse-embedding"
# Назначение: id embedding-модели, который Open WebUI передаёт в /v1/embeddings.
EMBEDDING_MODEL_PATH="./models/st/LaBSE"
# Назначение: путь к retrieval embedding-модели для отдельного runtime.
EMBEDDING_DEVICE="cpu"
# Назначение: устройство отдельного embedding runtime; обычно cpu, cuda или cuda:N.
EMBEDDING_DIM=
# Назначение: ожидаемая размерность embedding-вектора; пусто означает не фиксировать в runtime health.
EMBEDDING_NORMALIZE=true
# Назначение: включает нормализацию embedding-векторов перед отдачей в Open WebUI.
EMBEDDING_MAX_BATCH_SIZE=8
# Назначение: максимальный batch size внутри отдельного embedding runtime.
EMBEDDING_MAX_CONCURRENCY=4
# Назначение: максимальное число одновременных embedding-запросов вне UMS data-path.

DOC_SERVER_URL="http://localhost:8001"
# Назначение: URL document-сервера для внутренних HTTP-вызовов.
LEGAL_SERVER_URL="http://localhost:8002"
# Назначение: URL legal-сервера для внутренних HTTP-вызовов.
MCP_DOCUMENT_SERVER_URL="http://localhost:8001"
# Назначение: URL document MCP server для оркестратора.
MCP_LEGAL_SERVER_URL="http://localhost:8002"
# Назначение: URL legal MCP server для оркестратора.

# -------------------------------------------
# Persistence / local state
# -------------------------------------------
ORCHESTRATOR_STATE_DB_URL="sqlite:///.data/orchestrator_state.db"
# Назначение: SQLite-хранилище состояния orchestration jobs.
ORCHESTRATOR_KB_DB_URL="sqlite:///.data/orchestrator_kb.db"
# Назначение: SQLite-хранилище метаданных базы знаний оркестратора.

# -------------------------------------------
# Режим backend-инференса
# -------------------------------------------
BACKEND_MODE="llama-cpp-python"
# Назначение: runtime backend для тяжёлых моделей; варианты: llama-cpp-python, llama-server, vllm.
UMS_LLAMA_CACHE_PROMPT=true
# Назначение: включает prompt cache для локального llama-server heavy path.
VLLM_BASE_URL="http://localhost:8101"
# Назначение: base URL внешнего или локального vLLM OpenAI-compatible сервера.
VLLM_API_KEY=""
# Назначение: API key для vLLM, если сервер требует авторизацию.
VLLM_MODEL_ID_QWEN_14B_LLM="qwen-14b-llm"
# Назначение: имя модели, которое отдаёт vLLM для qwen-14b-llm.
VLLM_PORT=8101
# Назначение: host-порт локального vLLM контейнера или процесса.
VLLM_IMAGE="vllm/vllm-openai:latest"
# Назначение: Docker image для локального vLLM profile.
VLLM_MODEL_SOURCE_QWEN_14B_LLM="Qwen/Qwen2.5-14B-Instruct"
# Назначение: upstream model id или путь для vLLM qwen-14b-llm.
VLLM_TENSOR_PARALLEL_SIZE=1
# Назначение: tensor parallel size для vLLM.
VLLM_GPU_MEMORY_UTILIZATION=0.9
# Назначение: доля VRAM, которую vLLM может резервировать.
VLLM_MAX_MODEL_LEN=16384
# Назначение: максимальный контекст модели в vLLM.

# -------------------------------------------
# Активная модель и предзагрузка
# -------------------------------------------
DEFAULT_ACTIVE_MODEL_ID=""
# Назначение: необязательный fallback, если нет сохранённой последней активной модели.
ACTIVE_MODEL_ID="none"
# Назначение: legacy-поле для старых скриптов; UMS bootstrap использует DEFAULT_ACTIVE_MODEL_ID.
UMS_PRELOAD_LAST_ACTIVE_MODEL="true"
# Назначение: при старте предзагружает последнюю активную тяжёлую модель из UMS state вместо дефолтной тяжёлой модели.

# -------------------------------------------
# Chainlit UI (auth + persistence)
# -------------------------------------------
CHAINLIT_AUTH_SECRET="llm-tools-platform-secret-key-change-me"
# Назначение: секрет подписи сессий Chainlit.
CHAINLIT_ADMIN_USER="admin"
# Назначение: имя локального администратора Chainlit.
CHAINLIT_ADMIN_PASSWORD="admin"
# Назначение: пароль локального администратора Chainlit.
CHAINLIT_PORT=3000
# Назначение: host-порт совместимого Chainlit UI.
CHAINLIT_DB_URL="sqlite+aiosqlite:////abs/path/to/llm-tools-platform/backend/.data/chainlit.db"
# Назначение: SQLite-хранилище Chainlit data layer.
CHAINLIT_ENABLE_DATA_LAYER="true"
# Назначение: включает сохранение Chainlit-сессий в data layer.
CHAINLIT_SQLITE_TIMEOUT_S="30"
# Назначение: timeout SQLite-операций Chainlit.
GF_SECURITY_ADMIN_USER="admin"
# Назначение: имя администратора Grafana.
GF_SECURITY_ADMIN_PASSWORD="change-me-grafana"
# Назначение: пароль администратора Grafana.
CHAINLIT_DEFAULT_TEMPERATURE=0.7
# Назначение: дефолтная температура генерации в Chainlit.
CHAINLIT_DEFAULT_TOP_P=0.9
# Назначение: дефолтный top_p генерации в Chainlit.
CHAINLIT_DEFAULT_MAX_TOKENS=2048
# Назначение: дефолтный лимит новых токенов в Chainlit.
CHAINLIT_MODEL_PROFILE_DEFAULT_CHAT_MODEL="qwen-14b-llm"
# Назначение: модель профиля обычного чата в Chainlit.
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_MODEL="qwen-14b-llm"
# Назначение: модель профиля длинного контекста в Chainlit.
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_MODEL="qwen-14b-llm"
# Назначение: модель профиля сравнения юридических документов.
CHAINLIT_MODEL_PROFILE_LOW_VRAM_MODEL="phi-3-mini-q4"
# Назначение: модель профиля низкого потребления VRAM.
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_TEMPERATURE=0.3
# Назначение: температура профиля длинного контекста.
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_TOP_P=0.9
# Назначение: top_p профиля длинного контекста.
CHAINLIT_MODEL_PROFILE_LONG_CONTEXT_MAX_TOKENS=3072
# Назначение: лимит токенов профиля длинного контекста.
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_TEMPERATURE=0.2
# Назначение: температура профиля юридического сравнения.
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_TOP_P=0.8
# Назначение: top_p профиля юридического сравнения.
CHAINLIT_MODEL_PROFILE_LEGAL_COMPARE_MAX_TOKENS=2048
# Назначение: лимит токенов профиля юридического сравнения.
CHAINLIT_MODEL_PROFILE_LOW_VRAM_TEMPERATURE=0.2
# Назначение: температура профиля низкого потребления VRAM.
CHAINLIT_MODEL_PROFILE_LOW_VRAM_TOP_P=0.8
# Назначение: top_p профиля низкого потребления VRAM.
CHAINLIT_MODEL_PROFILE_LOW_VRAM_MAX_TOKENS=1024
# Назначение: лимит токенов профиля низкого потребления VRAM.
CHAINLIT_INTENT_EMBEDDER_PROFILE_DEFAULT_MODEL="qwen3-embedding-0.6b"
# Назначение: embedding-модель классификации намерений для Chainlit.
CHAINLIT_RETRIEVAL_EMBEDDER_PROFILE_LEGAL_DEFAULT_MODEL="labse-embedding"
# Назначение: retrieval embedding-модель юридического профиля Chainlit.
CHAINLIT_RETRIEVAL_EMBEDDER_PROFILE_LOW_VRAM_MODEL="labse-embedding"
# Назначение: retrieval embedding-модель low-VRAM профиля Chainlit.
CHAINLIT_REPORT_PDF_DISPLAY="inline"
# Назначение: режим отображения PDF-отчётов в Chainlit.

# -------------------------------------------
# Open WebUI eval contour (auth + bootstrap)
# -------------------------------------------
WEBUI_SECRET_KEY="llm-tools-platform-openwebui-dev-secret-change-me"
# Назначение: секрет Open WebUI для подписи внутренних токенов и сессий.
WEBUI_ADMIN_EMAIL="admin@example.com"
# Назначение: email bootstrap-администратора Open WebUI.
WEBUI_ADMIN_PASSWORD="change-me-now"
# Назначение: пароль bootstrap-администратора Open WebUI.
WEBUI_ADMIN_NAME="llm-tools-platform Admin"
# Назначение: отображаемое имя bootstrap-администратора Open WebUI.
ENABLE_SIGNUP="true"
# Назначение: разрешает регистрацию пользователей в Open WebUI.
DEFAULT_USER_ROLE="pending"
# Назначение: роль новых пользователей Open WebUI до ручного утверждения.
OPENWEBUI_DATA_PROFILE=""
# Назначение: профиль данных для native-запуска Open WebUI; пусто означает dev для --openwebui-dev и stable для Docker Compose.
OPENWEBUI_DEV_DATA_DIR="./.data/openwebui-dev"
# Назначение: локальный DATA_DIR для запуска текущего форка Open WebUI через --openwebui-dev.
OPENWEBUI_STABLE_DATA_DIR="./.data/openwebui-stable"
# Назначение: локальный постоянный DATA_DIR для stable-профиля, когда Open WebUI запускается без контейнерного volume.
OPENWEBUI_SMOKE_DATA_DIR="/tmp/openwebui-qdrant-smoke/data"
# Назначение: временный DATA_DIR только для smoke-проверок Open WebUI.
OPENWEBUI_QDRANT_COLLECTION_PREFIX=""
# Назначение: явный prefix коллекций Qdrant для Open WebUI; если пусто, run_native выбирает prefix по OPENWEBUI_DATA_PROFILE.

# -------------------------------------------
# OpenAPI Tool Server eval contour
# -------------------------------------------
OPENAPI_TOOL_SERVER_ENABLED="true"
# Назначение: включает backend-owned OpenAPI tool server для Open WebUI.
OPENAPI_TOOL_SERVER_TOKEN="llm-tools-platform-tool-server-dev-token-change-me"
# Назначение: bearer-токен для доступа Open WebUI к tool server.
OPENAPI_TOOL_SERVER_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"
# Назначение: разрешённые origin для вызовов tool server.
OPENWEBUI_EXPLICIT_TOOL_JOB_START_DELAY_S="6"
# Назначение: задержка старта deep-job, чтобы Open WebUI успел показать accepted-state.

# -------------------------------------------
# Operator UI access policy
# -------------------------------------------
OPERATOR_UI_LOCALHOST_ONLY="true"
# Назначение: ограничивает operator UI localhost-доступом.

# -------------------------------------------
# Intent classifier policy
# -------------------------------------------
INTENT_CLASSIFIER_MODE="embedder"
# Назначение: режим классификации намерений; варианты: embedder, llm, hybrid.
INTENT_CLASSIFIER_EMBEDDER_MODEL="qwen3-embedding-0.6b"
# Назначение: модель для embedder-классификации намерений.
INTENT_CLASSIFIER_LLM_MODEL="qwen-14b-llm"
# Назначение: LLM для классификации намерений в llm/hybrid-режимах.
INTENT_CLASSIFIER_LLM_CONFIDENCE_THRESHOLD="0.75"
# Назначение: минимальная уверенность LLM-классификатора.
INTENT_CLASSIFIER_EMBEDDER_CONFIDENCE_THRESHOLD="0.60"
# Назначение: минимальная уверенность embedder-классификатора.
INTENT_CLASSIFIER_EMBEDDER_MARGIN_THRESHOLD="0.10"
# Назначение: минимальный отрыв лучшего intent от второго.
LEGAL_EMBEDDER_MODEL="labse-embedding"
# Назначение: embedding-модель для юридических документов и semantic matching.

# -------------------------------------------
# RAG Pipeline
# -------------------------------------------
RAG_MODE_OVERRIDE="auto"
# Назначение: режим RAG; auto берётся из tier config, иначе simple/corrective/agentic.
KB_BACKEND="qdrant"
# Назначение: backend хранилища знаний.
QDRANT_URL="http://127.0.0.1:6333"
# Назначение: URL Qdrant для backend-сервисов при native-запуске.
QDRANT_COLLECTION_NAME="rag_chunks_v1"
# Назначение: коллекция Qdrant для backend RAG-индекса.
SESSION_RAG_TTL_HOURS="72"
# Назначение: время жизни session-level RAG handoff данных.

# -------------------------------------------
# UMS concurrency policy
# -------------------------------------------
UMS_LLM_MAX_CONCURRENCY=1
# Назначение: максимальное число одновременных heavy LLM запросов.
UMS_EMBED_MAX_CONCURRENCY=4
# Назначение: максимальное число одновременных embedding-запросов.
UMS_CONCURRENCY_ACQUIRE_TIMEOUT_S=5.0
# Назначение: время ожидания свободного concurrency slot.
UMS_FAIL_FAST_ON_SATURATION=false
# Назначение: если true, UMS быстро возвращает ошибку при насыщении concurrency.

# -------------------------------------------
# Report rendering
# -------------------------------------------
REPORT_PDF_FONT_PATH=""
# Назначение: явный путь к шрифту PDF-отчётов; пусто означает автообнаружение.

# -------------------------------------------
# Native / host runtime basics
# -------------------------------------------
UPLOADS_DIR="./open_webui_uploads"
# Назначение: общий каталог загрузок Open WebUI и backend-инструментов.
HOST_UPLOADS_DIR=""
# Назначение: host-путь uploads при контейнерном режиме; пусто для native.
CONDA_ENV="base"
# Назначение: conda-окружение для native-запуска backend-сервисов.

# ===========================================
# Native dev overrides (host-only, no Docker)
# Copy to backend/.env.native and adjust if needed
# ===========================================

# Этот файл для host-only native overrides.
# Runtime placement overrides лучше хранить отдельно в:
#   backend/.env.hardware.override
# или передавать custom файл через:
#   ./scripts/launcher.sh --target native --hardware-override-file /path/to/runtime.override.env

# Core URLs (host networking)
MCP_DOCUMENT_SERVER_URL="http://localhost:8001"
MCP_LEGAL_SERVER_URL="http://localhost:8002"
UMS_URL="http://localhost:8090"

# Uploads on host filesystem
UPLOADS_DIR="/home/seral/HDD/proj/agent-navigator-pro/backend/open_webui_uploads"
HOST_UPLOADS_DIR=""

# Ports (optional overrides)
AGENT_API_PORT=8000
UMS_PORT=8090
CHAINLIT_PORT=3000

# Recommended: conda base. Old custom envs still work if they really exist.
CONDA_ENV="base"

# Chainlit persistence (native)
CHAINLIT_DB_URL="sqlite+aiosqlite:////home/seral/HDD/proj/agent-navigator-pro/backend/.data/chainlit.db"
CHAINLIT_ENABLE_DATA_LAYER="true"
CHAINLIT_SQLITE_TIMEOUT_S="30"
CHAINLIT_REPORT_PDF_DISPLAY="inline"

# Optional: native-only backend mode override
# BACKEND_MODE="llama-cpp-python"
# BACKEND_MODE="vllm"

# Optional: report font override if system fonts are not discovered automatically
# REPORT_PDF_FONT_PATH="/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"

# Optional: absolute model paths for WSL/second disk layout
# MODEL_PATH_LLM="/mnt/d/agent-models/gguf/qwen-14b/Qwen2.5-14B-Instruct-Q4_K_M.gguf"
# MODEL_PATH_VLM="/mnt/d/agent-models/gguf/Qwen3-VL-8B-Q4/Qwen3-VL-8B-Instruct-Q4_K_M.gguf"
# MMPROJ_PATH="/mnt/d/agent-models/gguf/Qwen3-VL-8B-Q4/mmproj-Qwen3-VL-8B-Instruct-F16.gguf"
# MODEL_PATH_EMBEDDING_INTENT="/mnt/d/agent-models/st/Qwen3-Embedding-0.6B"
# MODEL_PATH_EMBEDDING_RETRIEVAL="/mnt/d/agent-models/st/LaBSE"

# Intent classifier policy
# Обычно наследуется из .env.
# Здесь переопределяйте только если для native-режима нужен отдельный профиль.
# INTENT_CLASSIFIER_MODE="embedder"
# INTENT_CLASSIFIER_EMBEDDER_MODEL="qwen3-embedding-0.6b"
# INTENT_CLASSIFIER_LLM_MODEL="qwen-14b-llm"
# INTENT_CLASSIFIER_LLM_CONFIDENCE_THRESHOLD="0.75"

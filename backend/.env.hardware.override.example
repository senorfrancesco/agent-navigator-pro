# User-owned hardware/runtime overrides.
# Copy to backend/.env.hardware.override or point launcher to a custom file:
#   ./scripts/launcher.sh --target native --hardware-override-file /path/to/runtime.override.env

UMS_RUNTIME_PROFILE="adaptive"

# Fallback heavy runtime path
DEVICE_MODE="hybrid"

# Component-specific placement
LLM_DEVICE_MODE="hybrid"
VLM_DEVICE_MODE="hybrid"
INTENT_EMBEDDER_DEVICE_MODE="cpu"
RETRIEVAL_EMBEDDER_DEVICE_MODE="cpu"

# GPU layers contract for LLM
GPU_LAYERS_MODE="auto"
N_GPU_LAYERS_OVERRIDE=
